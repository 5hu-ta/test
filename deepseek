local function setESP(v)
    ESP.enabled = v
    CONFIG.ESP.Enabled = v
    espBtn.Text = v and "ESP: ON" or "ESP: OFF"
    espBtn.BackgroundColor3 = v
        and Color3.fromRGB(70, 160, 100)
        or  Color3.fromRGB(100, 100, 100)
    if not v then
        for plr in pairs(ESP.cache) do destroyESP(plr) end
    end
end
