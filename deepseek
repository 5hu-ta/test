        if char then
            local commF, commE = getRemotes()

            if State.AutoKen and commE then
                pcall(function() commE:FireServer("Ken", true) end)
            end

            if State.AutoBuso and commF then
                pcall(function()
                    if not char:HasTag("Buso") then
                        commF:InvokeServer("BuyHaki", "Buso")
                    elseif not char:FindFirstChild("HasBuso") then
                        commF:InvokeServer("Buso")
                    end
                end)
            end

            if State.AutoV3 and commE then
                pcall(function() commE:FireServer("ActivateAbility") end)
            end

            if State.AutoV4 then
                pcall(function()
                    local backpack = LP:FindFirstChild("Backpack")
                    local awakening = backpack and backpack:FindFirstChild("Awakening")
                    local energy = char:FindFirstChild("RaceEnergy")
                    local transformed = char:FindFirstChild("RaceTransformed")
                    if awakening and energy and transformed then
                        if energy.Value >= 1 and not transformed.Value then
                            awakening.RemoteFunction:InvokeServer({true})
                        end
