local function setESP(v)
    ESP.enabled = v; CONFIG.ESP.Enabled = v
    espBtn.Text = v and "ESP: ON" or "ESP: OFF"
    espBtn.BackgroundColor3 = v and Color3.fromRGB(70,160,100) or Color3.fromRGB(100,100,100)
    if not v then for plr in pairs(ESP.cache) do destroyESP(plr) end end
end
espBtn.MouseButton1Click:Connect(function() setESP(not ESP.enabled) end)

local function setEnabled(v)
    CONFIG.Enabled = v
    toggle.Text = v and "STOP" or "START"
    toggle.BackgroundColor3 = v and Color3.fromRGB(220,60,60) or Color3.fromRGB(70,120,220)
end
toggle.MouseButton1Click:Connect(function() setEnabled(not CONFIG.Enabled) end)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CONFIG.ToggleKey then setEnabled(not CONFIG.Enabled) end
end)

task.spawn(function()
    while task.wait(0.2) do
        if not CONFIG.Enabled then status.Text = "Target: none"
        elseif currentTarget then
            local myHRP = getHRP(getChar(LP))
            local tHRP = getHRP(getChar(currentTarget))
            local d = (myHRP and tHRP) and (tHRP.Position - myHRP.Position).Magnitude or 0
            status.Text = string.format("Target: %s [%d]", currentTarget.Name, math.floor(d))
        else status.Text = "Target: none" end
    end
end)

