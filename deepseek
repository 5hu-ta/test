    if not remotes then return nil, nil end
    return remotes:FindFirstChild("CommF_"), remotes:FindFirstChild("CommE")
end

-- ============================================
-- FPS / PING TRACKER
-- ============================================
task.spawn(function()
    local frames = 0
    local lastTime = tick()
    RunService.Heartbeat:Connect(function()
        frames = frames + 1
        local now = tick()
        if now - lastTime >= 1 then
            Runtime.FPS = frames / (now - lastTime)
            frames = 0
            lastTime = now
        end
        pcall(function()
            Runtime.Ping = math.floor(LP:GetNetworkPing() * 1000)
        end)
    end)
end)

-- ============================================
-- AUTO JOIN TEAM (uses TEAM constant)
-- ============================================
local function tryJoinTeam(teamName)
    local commF = getRemotes()
    if not commF then return false end
    if LP.Team then return false end
    pcall(function() commF:InvokeServer("SetTeam", teamName) end)
    task.wait(0.3)
    return LP.Team ~= nil
end

task.spawn(function()
    task.wait(2)
    for _ = 1, 15 do
        if not State.Loaded then return end
        if LP.Team then return end
        if tryJoinTeam(TEAM) then
            print("[Extract v12] Auto-joined " .. TEAM .. ".")
            return
        end
        task.wait(2)
    end
    warn("[Extract v12] Auto-join " .. TEAM .. " timed out.")
end)

-- ============================================
-- REMOVE LAVA (auto on load)
-- ============================================
local function removeLava()
    local removed = false
    local mapPart = workspace:FindFirstChild("Map")
    if mapPart then
        for _, mapName in ipairs({"CircleIsland", "GhostShipInterior"}) do
            local v2 = mapPart:FindFirstChild(mapName)
            if v2 then
                for _, desc in ipairs(v2:GetDescendants()) do
                    if desc.Name == "LavaParts" then
                        desc:Destroy()
                        removed = true
                    end
                end
            end
        end
    end
    return removed
end

task.spawn(function()
    task.wait(1)
    for _ = 1, 10 do
        if not State.Loaded then return end
        if removeLava() then
            Runtime.LavaRemoved = true
            print("[Extract v12] Lava removed.")
            return
        end
        task.wait(2)
    end
end)

-- ============================================
-- NO FOG (always-on)
-- ============================================
local function applyNoFog()
    local lighting = game:GetService("Lighting")
    lighting.FogEnd = math.huge
    for _, name in ipairs({"FantasySky", "LightingLayers", "Sky", "SeaTerrorCC"}) do
        local obj = lighting:FindFirstChild(name)
        if obj then pcall(function() obj:Destroy() end) end
    end
    Runtime.NoFogApplied = true
end

-- ============================================
-- FORCE FPS BOOST (always-on, reapply 60s)
-- ============================================
local function forceFPSBoost()
    local lighting = game:GetService("Lighting")
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 0
    end
    lighting.GlobalShadows = false
    lighting.FogEnd = 9e9
    pcall(function() settings().Rendering.QualityLevel = 1 end)

    for _, d in pairs(game:GetDescendants()) do
        if d:IsA("Part") or d:IsA("UnionOperation") or d:IsA("MeshPart")
            or d:IsA("CornerWedgePart") or d:IsA("TrussPart") then
            pcall(function()
                d.Material = Enum.Material.Plastic
                d.Reflectance = 0
            end)
        elseif d:IsA("Decal") then
            pcall(function() d.Transparency = 1 end)
        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") then
            pcall(function() d.Lifetime = NumberRange.new(0) end)
        elseif d:IsA("Explosion") then
            pcall(function()
                d.BlastPressure = 1
                d.BlastRadius = 1
            end)
        end
    end

    for _, d in pairs(lighting:GetDescendants()) do
        if d:IsA("BlurEffect") or d:IsA("SunRaysEffect")
            or d:IsA("ColorCorrectionEffect") or d:IsA("BloomEffect")
            or d:IsA("DepthOfFieldEffect") then
            pcall(function() d.Enabled = false end)
        end
    end

    for _, d in pairs(workspace:GetDescendants()) do
        if d:IsA("ForceField") or d:IsA("Sparkles")
            or d:IsA("Smoke") or d:IsA("Fire") then
            pcall(function() d:Destroy() end)
        end
    end
    Runtime.FPSApplied = true
end

task.spawn(function()
    task.wait(0.5)
    while State.Loaded do
        pcall(forceFPSBoost)
        task.wait(60)
    end
end)

