--[[
    AutoBounty v2 — fixed
    Changes:
      - RequirePvP default false
      - Safezone check optional (CheckSafezone = false)
      - RegisterHit with 4th attackId arg
      - Tool detection from Character + Backpack
      - CFrame.lookAt corrected
      - ESP adornee fallback to HumanoidRootPart
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local LP                = Players.LocalPlayer

local CONFIG = {
    Enabled         = false,
    ChaseEnabled    = true,
    ChaseSpeed      = 300,
    AttackRange     = 60,
    BuddhaRange     = 1000,
    AttackInterval  = 0.1,
    ScanInterval    = 0.1,
    TeamCheck       = true,
    RequirePvP      = false,     -- 修正: デフォルトOFF
    CheckSafezone   = false,     -- 修正: セーフゾーン判定を無効化
    ToggleKey       = Enum.KeyCode.F1,
    ESP = {
        Enabled     = true,
        UpdateRate  = 0.2,
        MaxDistance = 3000,
    },
}

local function getChar(plr) return plr and plr.Character end
local function getHRP(char)  return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart) end
local function getHum(char)  return char and char:FindFirstChildOfClass("Humanoid") end
local function getHead(char) return char and char:FindFirstChild("Head") end

-- 修正: セーフゾーン判定を簡略化（CheckSafezone=falseなら即false）
local function inSafezone(char)
    if not CONFIG.CheckSafezone then return false end
    local hrp = getHRP(char)
    if not hrp then return true end
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    if not worldOrigin then return false end
    local safezones = worldOrigin:FindFirstChild("SafeZones")
    if not safezones then return false end
    for _, zone in ipairs(safezones:GetChildren()) do
        if zone:IsA("BasePart") then
            local mesh = zone:FindFirstChild("Mesh")
            local radius = mesh and (zone.Size.X * mesh.Scale.X / 2) or (zone.Size.Magnitude / 2)
            if (hrp.Position - zone.Position).Magnitude <= radius then
                return true
            end
        end
    end
    return false
end

local function isBountyTarget(plr)
    if plr == LP then return false end
    local char = getChar(plr)
    local hum  = getHum(char)
    if not (char and hum and hum.Health > 0) then return false end
    if inSafezone(char) then return false end
    if CONFIG.TeamCheck and LP.Team and plr.Team == LP.Team then return false end
    if CONFIG.RequirePvP then
        local pvpDisabled = plr:GetAttribute("PvpDisabled")
        if pvpDisabled ~= false then return false end
    end
    return true
end

local currentTarget = nil
local lastScan = 0

local function scanTarget()
    if tick() - lastScan < CONFIG.ScanInterval then return end
    lastScan = tick()
    local myHRP = getHRP(getChar(LP))
    if not myHRP then currentTarget = nil; return end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isBountyTarget(plr) then
            local hrp = getHRP(plr.Character)
            if hrp then
                local d = (hrp.Position - myHRP.Position).Magnitude
                if d < bestDist then best, bestDist = plr, d end
            end
        end
    end
    currentTarget = best
end

local ghostPart, currentTween
local function ensureGhost()
    if ghostPart and ghostPart.Parent then return end
    ghostPart = Instance.new("Part")
    ghostPart.Size = Vector3.new(4,1,4)
    ghostPart.Anchored = true
    ghostPart.CanCollide = false
    ghostPart.Transparency = 1
    ghostPart.Parent = workspace
    local myHRP = getHRP(getChar(LP))
    if myHRP then ghostPart.Position = myHRP.Position end
end

local function tweenTP(targetPos)
    local myHRP = getHRP(getChar(LP))
    if not myHRP then return end
    ensureGhost()
    if not ghostPart or not ghostPart.Parent then return end
    if currentTween then currentTween:Cancel() end
    local dist = (targetPos - ghostPart.Position).Magnitude
    if dist < 1 then
        myHRP.CFrame = CFrame.lookAt(targetPos, targetPos + (myHRP.CFrame.LookVector * 5))
        return
    end
    local duration = dist / CONFIG.ChaseSpeed
    currentTween = TweenService:Create(ghostPart,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { Position = targetPos })
    -- 修正: lookAtを正しく（自分の位置からターゲットを見る）
    local myPos = myHRP.Position
    myHRP.CFrame = CFrame.lookAt(myPos, targetPos)
    currentTween:Play()
end

-- 修正: Character と Backpack の両方からツールを探す
local function getEquippedTool()
    local char = getChar(LP)
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then return child end
        end
    end
    local backpack = LP:FindFirstChild("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then return child end
        end
    end
    return nil
end

local function getAttackRange()
    local myHRP = getHRP(getChar(LP))
    if not myHRP then return CONFIG.AttackRange end
    if myHRP:FindFirstChild("Buddha") then return CONFIG.BuddhaRange end
    return CONFIG.AttackRange
end

-- 修正: RegisterHit に attackId を追加
local function fastAttack()
    local myChar = getChar(LP)
    local myHRP  = getHRP(myChar)
    if not myHRP then return end
    local tool = getEquippedTool()
    if not tool then return end
    local range = getAttackRange()

    local hitList = {}
    local firstHead = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = getChar(plr)
            local hum  = getHum(char)
            local hrp  = getHRP(char)
            local head = getHead(char)
            if char and hum and hrp and head and hum.Health > 0 then
                if (hrp.Position - myHRP.Position).Magnitude <= range then
                    table.insert(hitList, {char, head})
                    if not firstHead then firstHead = head end
                end
            end
        end
    end
    if not firstHead then return end

    if tool:FindFirstChild("LeftClickRemote") then
        local idx = 1
        for _, entry in ipairs(hitList) do
            local hrp = getHRP(entry[1])
            if hrp then
                local dir = (hrp.Position - myHRP.Position).Unit
                pcall(function() tool.LeftClickRemote:FireServer(dir, idx) end)
                idx = idx + 1
            end
        end
        return
    end

    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if not net then return end
    local regAttack = net:FindFirstChild("RE/RegisterAttack")
    local regHit    = net:FindFirstChild("RE/RegisterHit")
    if not (regAttack and regHit) then return end

    -- 修正: attackId を第4引数に追加
    local attackId = tostring(math.random(100000,999999))
    pcall(function()
        regAttack:FireServer(0.1)
        regHit:FireServer(firstHead, hitList, nil, attackId)
    end)
end

-- ============================================
-- ESP
-- ============================================
local ESP = { enabled = CONFIG.ESP.Enabled, cache = {} }

local function fmtNum(n)
    if not n then return "?" end
    if n >= 1e6 then return string.format("%.1fM", n/1e6) end
    if n >= 1e3 then return string.format("%.1fK", n/1e3) end
    return tostring(n)
end

local function getBounty(plr)
    local d = plr:FindFirstChild("Data")
    local b = d and d:FindFirstChild("Bounty")
    if b then return b.Value end
    return plr:GetAttribute("Bounty")
end
local function getLevel(plr)
    local d = plr:FindFirstChild("Data")
    local l = d and d:FindFirstChild("Level")
    if l then return l.Value end
    return plr:GetAttribute("Level")
end
local function getPvP(plr)
    local a = plr:GetAttribute("PvpDisabled")
    if a == false then return "ON", "rgb(255,80,80)" end
    if a == true  then return "OFF", "rgb(120,120,120)" end
    return "?", "rgb(180,180,180)"
end

local function buildText(plr, hum, dist)
    local pvp, pvpCol = getPvP(plr)
    return string.format(
        "<b>%s</b> <font color='rgb(180,180,180)'>[%d]</font>\n"..
        "<font color='rgb(255,220,120)'>HP %d/%d</font> "..
        "<font color='rgb(120,220,120)'>Lv %s</font>\n"..
        "<font color='rgb(200,160,255)'>B %s</font> "..
        "<font color='%s'>PvP %s</font> "..
        "<font color='rgb(150,200,255)'>%dm</font>",
        plr.Name, plr.UserId, math.floor(hum.Health), math.floor(hum.MaxHealth),
        getLevel(plr) and tostring(getLevel(plr)) or "?",
        fmtNum(getBounty(plr)), pvpCol, pvp, math.floor(dist)
    )
end

local function createESP(plr)
    local char = getChar(plr)
    if not char then return nil end
    local adorn = getHead(char) or getHRP(char)   -- 修正: HeadなければHRP
    if not adorn then return nil end
    local old = ESP.cache[plr]; if old then old:Destroy() end
    local bg = Instance.new("BillboardGui")
    bg.Name = "AB_ESP"
    bg.Size = UDim2.new(0, 220, 0, 70)
    bg.StudsOffset = Vector3.new(0, 3, 0)
    bg.AlwaysOnTop = true
    bg.Adornee = adorn
    bg.Parent = adorn
    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1,1,1)
    label.TextStrokeTransparency = 0.6
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.RichText = true
    label.TextWrapped = true
    label.Parent = bg
    ESP.cache[plr] = bg
    return bg
end

local function destroyESP(plr)
    local bg = ESP.cache[plr]
    if bg then bg:Destroy(); ESP.cache[plr] = nil end
end

local function updateESP()
    if not ESP.enabled then
        for plr in pairs(ESP.cache) do destroyESP(plr) end
        return
    end
    local myHRP = getHRP(getChar(LP))
    if not myHRP then return end
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then destroyESP(plr); continue end
        local char = getChar(plr)
        local hum  = getHum(char)
        local tHRP = getHRP(char)
        if not (char and hum and tHRP and hum.Health > 0) then
            destroyESP(plr); continue
        end
        local dist = (myHRP.Position - tHRP.Position).Magnitude
        if dist > CONFIG.ESP.MaxDistance then destroyESP(plr); continue end
        seen[plr] = true
        local bg = ESP.cache[plr]
        if not bg or not bg.Parent then bg = createESP(plr) end
        if bg then
            bg.Adornee = getHead(char) or tHRP
            local label = bg:FindFirstChild("Info")
            if label then label.Text = buildText(plr, hum, dist) end
        end
    end
    for plr in pairs(ESP.cache) do
        if not seen[plr] then destroyESP(plr) end
    end
end

local espAccum = 0
RunService.Heartbeat:Connect(function(dt)
    espAccum = espAccum + dt
    if espAccum >= CONFIG.ESP.UpdateRate then
        espAccum = 0
        pcall(updateESP)
    end
end)

-- ============================================
-- Combat loop
-- ============================================
local lastAttack = 0
RunService.Heartbeat:Connect(function()
    if not CONFIG.Enabled then return end
    scanTarget()
    if not currentTarget then return end
    if not isBountyTarget(currentTarget) then currentTarget = nil; return end
    local tChar = getChar(currentTarget)
    local tHRP  = getHRP(tChar)
    local tHum  = getHum(tChar)
    if not (tHRP and tHum and tHum.Health > 0) then currentTarget = nil; return end
    local myHRP = getHRP(getChar(LP))
    if not myHRP then return end
    local targetPos = tHRP.Position - Vector3.new(0,3,0)
    local dist = (myHRP.Position - targetPos).Magnitude
    local range = getAttackRange()
    if CONFIG.ChaseEnabled and dist > range then
        tweenTP(targetPos)
        return
    end
    if tick() - lastAttack >= CONFIG.AttackInterval then
        fastAttack()
        lastAttack = tick()
    end
end)

