-- ============================================================
-- 2. SERVICES / HELPERS
-- ============================================================

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera      = Workspace.CurrentCamera

local function getCharacter(plr)
    return plr and plr.Character
end

local function getHumanoid(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot(char)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function getHead(char)
    return char and char:FindFirstChild("Head")
end

local function getRigType(humanoid)
    -- R6: Torso 存在 / R15: UpperTorso 存在
    local char = humanoid and humanoid.Parent
    if not char then return "R15" end
    return char:FindFirstChild("Torso") and "R6" or "R15"
end

local function worldToViewport(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

local function distance(a, b)
    return (a - b).Magnitude
end

-- ============================================================
-- 3. TARGET MANAGER
-- ============================================================

local TargetManager = {}
TargetManager.__index = TargetManager

function TargetManager.new()
    local self = setmetatable({}, TargetManager)
    self.current = nil
    self.lastScan = 0
    self.candidates = {}
    return self
end

local function isSameTeam(plr)
    if not CONFIG.Target.IgnoreTeams then return false end
    return plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team
end

local function isFriend(plr)
    if not CONFIG.Target.IgnoreFriends then return false end
    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(plr.UserId)
    end)
    return ok and result
end

function TargetManager:scan()
    local now = tick()
    if now - self.lastScan < CONFIG.Target.ScanInterval then
        return
    end
    self.lastScan = now
    self.candidates = {}

    local myChar = getCharacter(LocalPlayer)
    local myRoot = getRoot(myChar)
    if not myRoot then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if isSameTeam(plr) or isFriend(plr) then continue end

        local char = getCharacter(plr)
        local hum  = getHumanoid(char)
        local root = getRoot(char)

        if not (char and hum and root and hum.Health > 0) then continue end

        local hpPct = hum.Health / math.max(hum.MaxHealth, 1)
        if hpPct < CONFIG.Target.MinHealthPct or hpPct > CONFIG.Target.MaxHealthPct then
            continue
        end

        local dist = distance(myRoot.Position, root.Position)
        if dist > CONFIG.Target.MaxDistance then continue end

        table.insert(self.candidates, {
            Player   = plr,
            Character= char,
            Humanoid = hum,
            Root     = root,
            Head     = getHead(char),
            Distance = dist,
            HealthPct= hpPct,
            RigType  = getRigType(hum),
        })
    end

    -- sort
    table.sort(self.candidates, function(a, b)
        if CONFIG.Target.PreferLowHP and math.abs(a.HealthPct - b.HealthPct) > 0.1 then
            return a.HealthPct < b.HealthPct
        end
        return a.Distance < b.Distance
    end)

    self.current = self.candidates[1]
end

function TargetManager:getTarget()
    return self.current
end

-- ============================================================
-- 4. ESP
-- ============================================================

local ESP = {}
ESP.__index = ESP

function ESP.new()
    local self = setmetatable({}, ESP)
    self.objects = {}   -- [player] = { Box, Name, Health, Distance, Tracer }
    self.enabled = CONFIG.ESP.Enabled
    self.conn = nil
    return self
end

local function newDrawing(kind)
    if not COMPAT.Drawing then return nil end
    local ok, obj = pcall(Drawing.new, kind)
    return ok and obj or nil
end

function ESP:create(player)
    if not COMPAT.Drawing then return nil end

    local obj = {
        Box      = newDrawing("Square"),
        Name     = newDrawing("Text"),
        Health   = newDrawing("Square"),
        Distance = newDrawing("Text"),
        Tracer   = newDrawing("Line"),
    }

    if obj.Box then
        obj.Box.Thickness = 1
        obj.Box.Filled = false
    end
    if obj.Health then
        obj.Health.Filled = true
        obj.Health.Thickness = 1
    end
    if obj.Name then
        obj.Name.Size = 14
        obj.Name.Center = true
        obj.Name.Outline = true
    end
    if obj.Distance then
        obj.Distance.Size = 12
        obj.Distance.Center = true
        obj.Distance.Outline = true
    end
    if obj.Tracer then
        obj.Tracer.Thickness = 1
    end

    self.objects[player] = obj
    return obj
end

function ESP:destroy(player)
    local obj = self.objects[player]
    if not obj then return end
    for _, d in pairs(obj) do
        if d and d.Destroy then pcall(d.Destroy, d) end
    end
    self.objects[player] = nil
end

function ESP:update()
    if not self.enabled or not COMPAT.Drawing then return end

    local myChar = getCharacter(LocalPlayer)
    local myRoot = getRoot(myChar)
    if not myRoot then return end
    local myPos = myRoot.Position

    local seen = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = getCharacter(plr)
        local hum  = getHumanoid(char)
        local root = getRoot(char)
        local head = getHead(char)

        if not (char and hum and root and hum.Health > 0) then
            if self.objects[plr] then self:destroy(plr) end
            continue
        end

        local dist = distance(myPos, root.Position)
        if dist > CONFIG.ESP.MaxDistance then
            if self.objects[plr] then self:destroy(plr) end
            continue
        end

        seen[plr] = true
        local obj = self.objects[plr] or self:create(plr)
        if not obj then continue end

        -- color
        local color = CONFIG.ESP.Color
        if CONFIG.ESP.TeamColor and plr.Team then
            color = plr.Team.TeamColor.Color
        end

        -- 3D box corners → viewport
        local size = root.Size
        local topPos = root.Position + Vector3.new(0, size.Y / 2 + 0.5, 0)
        local botPos = root.Position - Vector3.new(0, size.Y / 2, 0)

        local topScr, topOn = worldToViewport(topPos)
        local botScr, botOn = worldToViewport(botPos)

        if not (topOn and botOn) then
            for _, d in pairs(obj) do if d then d.Visible = false end end
            continue
        end

        local height = math.abs(botScr.Y - topScr.Y)
        local width  = height * 0.6
        local centerX = (topScr.X + botScr.X) / 2
        local centerY = (topScr.Y + botScr.Y) / 2

        -- BOX
        if CONFIG.ESP.Box and obj.Box then
            obj.Box.Visible = true
            obj.Box.Color = color
            obj.Box.Size = Vector2.new(width, height)
            obj.Box.Position = Vector2.new(centerX - width / 2, topScr.Y)
        end

        -- NAME
        if CONFIG.ESP.Name and obj.Name then
            obj.Name.Visible = true
            obj.Name.Color = color
            obj.Name.Position = Vector2.new(centerX, topScr.Y - 18)
            obj.Name.Text = plr.Name
        end

        -- HEALTH
        if CONFIG.ESP.Health and obj.Health then
            local hpPct = hum.Health / math.max(hum.MaxHealth, 1)
            local barW = width
            local barH = 4
            obj.Health.Visible = true
            obj.Health.Color = Color3.fromRGB(255, math.floor(255 * hpPct), 0)
            obj.Health.Size = Vector2.new(barW * hpPct, barH)
            obj.Health.Position = Vector2.new(centerX - barW / 2, botScr.Y + 2)
        end

        -- DISTANCE
        if CONFIG.ESP.Distance and obj.Distance then
            obj.Distance.Visible = true
            obj.Distance.Color = Color3.fromRGB(220, 220, 220)
            obj.Distance.Position = Vector2.new(centerX, botScr.Y + 8)
            obj.Distance.Text = string.format("[%d]", math.floor(dist))
        end

        -- TRACER
        if CONFIG.ESP.Tracer and obj.Tracer then
            obj.Tracer.Visible = true
            obj.Tracer.Color = color
            obj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            obj.Tracer.To = Vector2.new(centerX, botScr.Y)
        end
    end

    -- cleanup
    for plr, _ in pairs(self.objects) do
        if not seen[plr] then self:destroy(plr) end
    end
end

function ESP:setEnabled(bool)
    self.enabled = bool
    if not bool then
        for plr, _ in pairs(self.objects) do self:destroy(plr) end
    end
end

-- ============================================================
-- 5. REMOTE HOOK / AUTO BOUNTY
-- ============================================================

local RemoteHook = {}
RemoteHook.__index = RemoteHook

function RemoteHook.new()
    local self = setmetatable({}, RemoteHook)
    self.hooked = false
    self.oldNamecall = nil
    self.claimRemote = nil
    return self
end

function RemoteHook:findClaimRemote()
    -- 自動検出: 名前でそれっぽいリモートを探す
    if not CONFIG.Remote.Enabled then return nil end
    if CONFIG.Remote.ClaimRemoteName then
        local found = ReplicatedStorage:FindFirstChild(CONFIG.Remote.ClaimRemoteName, true)
        return found
    end
    -- fallback: Bounty / Reward / Claim を含む RemoteEvent
    local function scan(parent)
        for _, child in ipairs(parent:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                local n = child.Name:lower()
                if n:find("bounty") or n:find("claim") or n:find("reward") then
                    return child
                end
            end
        end
    end
    return scan(ReplicatedStorage) or scan(Workspace)
end

function RemoteHook:install()
    if self.hooked then return end
    if not (COMPAT.getrawmetatable and COMPAT.hookmetamethod) then
        compat_warn("Cannot hook __namecall (missing getrawmetatable/hookmetamethod). Remote features disabled.")
        return
    end

    self.claimRemote = self:findClaimRemote()
    if CONFIG.Remote.Enabled and not self.claimRemote then
        compat_warn("Claim remote not found. Auto-claim disabled.")
    end

    local mt = getrawmetatable(game)
    local old
    old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        -- ここで発信リモートを監視
        if method == "FireServer" and self:IsA("RemoteEvent") then
            -- バウンティ受注/報酬受取の検出
            if self == self.claimRemote then
                -- フックしたリモートが発火されたらログ
                if CONFIG.UI.ShowConsole then
                    print("[AutoBounty] Claim remote fired:", self:GetFullName())
                end
            end
        end

        return old(self, ...)
    end))

    self.oldNamecall = old
    self.hooked = true
end

function RemoteHook:tryClaim()
    if not CONFIG.Remote.Enabled or not CONFIG.Remote.AutoClaim then return end
    local remote = self.claimRemote
    if not remote then return end
    pcall(function()
        remote:FireServer()
    end)
end

-- ============================================================
-- 6. AUTO EXECUTOR (chase + skill)
-- ============================================================

local AutoExecutor = {}
AutoExecutor.__index = AutoExecutor

function AutoExecutor.new(targetMgr)
    local self = setmetatable({}, AutoExecutor)
    self.targetMgr = targetMgr
    self.running = false
    self.conn = nil
    self.skillIndex = 1
    self.lastSkill = 0
    return self
end

local function isAlive(char)
    local hum = getHumanoid(char)
    return hum and hum.Health > 0
end

local function fireKey(key, holdTime)
    -- エグゼキュータのキー入力API。Delta/Xeno/Real は syn 互換の virtualinput を持つことが多い
    if typeof(key) == "string" then
        key = Enum.KeyCode[key]
    end
    if key then
        pcall(function()
            if syn and syn.keypress then
                syn.keypress(key)
                task.wait(holdTime or 0.05)
                syn.keyrelease(key)
            elseif keypress then
                keypress(key)
                task.wait(holdTime or 0.05)
                keyrelease(key)
            else
                -- fallback: VirtualInputManager
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true, key, false, game)
                task.wait(holdTime or 0.05)
                vim:SendKeyEvent(false, key, false, game)
            end
        end)
    end
end

function AutoExecutor:step()
    if not self.running then return end

    local target = self.targetMgr:getTarget()
    if not target then return end

    local myChar = getCharacter(LocalPlayer)
    local myHum  = getHumanoid(myChar)
    local myRoot = getRoot(myChar)
    local tgtRoot = target.Root

    if not (myHum and myRoot and tgtRoot and target.Humanoid.Health > 0) then
        return
    end

    local dist = distance(myRoot.Position, tgtRoot.Position)

    -- Chase
    if CONFIG.Auto.ChaseEnabled and dist > CONFIG.Auto.AttackRange then
        if myHum.WalkSpeed ~= CONFIG.Auto.ChaseSpeed then
            myHum.WalkSpeed = CONFIG.Auto.ChaseSpeed
        end
        -- 直線移動（簡易）。ゲームによっては PathfindingService 推奨
        local dir = (tgtRoot.Position - myRoot.Position).Unit
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, tgtRoot.Position)
        myHum:Move(dir, false)
    else
        if myHum.WalkSpeed ~= 16 then
            myHum.WalkSpeed = 16
        end
    end

    -- Skill combo
    if dist <= CONFIG.Auto.AttackRange then
        local now = tick()
        if now - self.lastSkill >= CONFIG.Auto.SkillDelay then
            local combo = CONFIG.Auto.Combo
            if #combo > 0 then
                local skill = combo[self.skillIndex]
                fireKey(skill.key, skill.hold)
                self.skillIndex = (self.skillIndex % #combo) + 1
                self.lastSkill = now
            end
        end
    end
end

function AutoExecutor:start()
    if self.running then return end
    self.running = true
    self.conn = RunService.Heartbeat:Connect(function()
        pcall(function() self:step() end)
    end)
end

function AutoExecutor:stop()
    self.running = false
    if self.conn then
        self.conn:Disconnect()
        self.conn = nil
    end
    -- restore speed
    local myHum = getHumanoid(getCharacter(LocalPlayer))
    if myHum and myHum.WalkSpeed ~= 16 then
        myHum.WalkSpeed = 16
    end
end

