-- self-contained toggle button factory
local function makeToggle(textOff, textOn, y, colorOff, colorOn, initialState, onChanged)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 28)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BackgroundColor3 = colorOff
    btn.BorderSizePixel = 0
    btn.Text = textOff
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local state = initialState

    local function render()
        btn.Text = state and textOn or textOff
        btn.BackgroundColor3 = state and colorOn or colorOff
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        if onChanged then
            pcall(onChanged, state)
        end
    end)

    return btn
end

-- TP toggle
makeToggle(
    "TP Chase: OFF", "TP Chase: ON",
    35,
    Color3.fromRGB(80, 80, 80), Color3.fromRGB(70, 140, 220),
    false,
    function(v)
        State.TPChase = v
        if not v then
            -- cancel any running tween
            local hrp = getHRP()
            if hrp then
                local hum = getHum()
                if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
            end
        end
    end
)

