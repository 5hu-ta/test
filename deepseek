local function commaFormat(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(n)
    local k
    repeat
        s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
    until k == 0
    return s
end

