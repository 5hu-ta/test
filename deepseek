-- ============================================
-- SAFEZONE / PVP DETECTION
-- (ported from Iruka Hub)
-- ============================================
local SafeZoneCache = {}
local SAFEZONE_CACHE_TTL = 0.3

local function isInSafeZone(plr)
    local now = tick()
    local cached = SafeZoneCache[plr.UserId]
    if cached and cached.expires > now then
        return cached.inSafe
    end

    local result = false
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local safeZones = worldOrigin and worldOrigin:FindFirstChild("SafeZones")

    if hrp and safeZones then
        for _, child in ipairs(safeZones:GetChildren()) do
            local mesh = child:FindFirstChild("Mesh")
            if mesh and (hrp.Position - child.Position).Magnitude <= child.Size.X * mesh.Scale.X / 2 then
                result = true
                break
            end
        end
    end

    SafeZoneCache[plr.UserId] = { inSafe = result, expires = now + SAFEZONE_CACHE_TTL }
    return result
end

local function isPvpOff(plr)
    -- In Blox Fruits, PvpDisabled == true means the player cannot be attacked.
    -- nil / false are treated as attackable (aggressive).
    return plr:GetAttribute("PvpDisabled") == true
end

local function isAttackable(plr)
    if plr == LP then return false end
    if State.RequirePvpOn and isPvpOff(plr) then return false end
    if State.RequireOutsideSafeZone and isInSafeZone(plr) then return false end
    return true
end

