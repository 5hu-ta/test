local function makeButton(text, xOffset, wOffset, colorOff, colorOn, initialState, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.20, wOffset, 1, 0)
    btn.Position = UDim2.new(xOffset, 0, 0, 0)
    btn.BackgroundColor3 = colorOff
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = footer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    if initialState ~= nil then
        local state = initialState
        local function render()
            btn.Text = state and (text .. ": ON") or (text .. ": OFF")
            btn.BackgroundColor3 = state and colorOn or colorOff
        end
        render()
        btn.MouseButton1Click:Connect(function()
            state = not state
            render()
            if onClick then onClick(state) end
        end)
    else
        btn.MouseButton1Click:Connect(function()
            if onClick then onClick() end
        end)
    end
    return btn
end

