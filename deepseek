local function makeBtn(text, y, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 28)
    btn.Position = UDim2.new(0, 10, 0, y)
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local tpBtn = makeBtn("TP Chase: OFF", 35, Color3.fromRGB(80,80,80), function()
    State.TPChase = not State.TPChase
    tpBtn.Text = State.TPChase and "TP Chase: ON" or "TP Chase: OFF"
    tpBtn.BackgroundColor3 = State.TPChase and Color3.fromRGB(70,140,220) or Color3.fromRGB(80,80,80)
end)

local m1Btn = makeBtn("Auto M1: OFF", 70, Color3.fromRGB(80,80,80), function()
    State.AutoM1 = not State.AutoM1
    m1Btn.Text = State.AutoM1 and "Auto M1: ON" or "Auto M1: OFF"
    m1Btn.BackgroundColor3 = State.AutoM1 and Color3.fromRGB(220,80,80) or Color3.fromRGB(80,80,80)
end)

local lavaBtn = makeBtn("Remove Lava", 105, Color3.fromRGB(160,80,80), function()
    local ok = removeLava()
    lavaBtn.Text = ok and "Lava removed!" or "No lava found"
    task.wait(1.5)
    lavaBtn.Text = "Remove Lava"
end)

-- Hotkeys
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.F1 then tpBtn.MouseButton1Click:Fire() end
    if input.KeyCode == Enum.KeyCode.F2 then m1Btn.MouseButton1Click:Fire() end
    if input.KeyCode == Enum.KeyCode.F3 then lavaBtn.MouseButton1Click:Fire() end
end)

print("[Extract] Loaded. F1=TP / F2=M1 / F3=Lava")
