local function snapFaceToTarget()
    local t = State.Target
    if not t or not t.Character then return end
    local head = t.Character:FindFirstChild("Head")
    local hrp = getHRP()
    if not (head and hrp) then return end
    hrp.CFrame = CFrame.lookAt(hrp.CFrame.Position, head.Position)
end

local function moveMouseToTarget()
    local t = State.Target
    if not t or not t.Character then return end
    local head = t.Character:FindFirstChild("Head")
    if not head then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local pos, onScreen = cam:WorldToViewportPoint(head.Position)
    if not onScreen then return end
    pcall(function()
        VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
    end)
end

-- ============================================
-- COMBO LOOP
-- ============================================
task.spawn(function()
    while State.Loaded do
        task.wait(0.1)

        if not State.AutoCombo then
            State.CurrentComboWeapon = nil
            State.ComboIndex = 1
            continue
        end

        local t = State.Target
        if not t or not t.Character then continue end
        local tHum = t.Character:FindFirstChildOfClass("Humanoid")
        local tHRP = t.Character:FindFirstChild("HumanoidRootPart")
        local hrp = getHRP()
        if not (tHum and tHum.Health > 0 and tHRP and hrp) then continue end
        if not isAttackable(t) then continue end
        if (tHRP.Position - hrp.Position).Magnitude > CONFIG.SkillMaxRange then continue end

        local order = CONFIG.ComboOrder
        local n = #order
        if n == 0 then continue end
        local weaponType = order[State.ComboIndex]
        local tool = findToolByType(weaponType)
        if not tool then
            State.ComboIndex = (State.ComboIndex % n) + 1
            continue
        end
        State.ComboIndex = (State.ComboIndex % n) + 1
        State.CurrentComboWeapon = weaponType

        if not equipTool(tool) then continue end
        task.wait(CONFIG.EquipWait)
        if not State.AutoCombo or not State.Loaded then break end

        local t2 = State.Target
        if not t2 or not t2.Character then continue end

        for _, key in ipairs(CONFIG.SkillKeys) do
            if not State.AutoCombo or not State.Loaded then break end
            snapFaceToTarget()
            moveMouseToTarget()
            fireKey(key)
            task.wait(CONFIG.SkillInterval)
        end
    end
end)

-- ============================================
-- TP CHASE
-- ============================================
local tpRunning = false

local function chaseLoop(plr)
    local hum = getHum()
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end

    -- Emergency lift if in water at chase start
    do
        local hrp0 = getHRP()
        if hrp0 and hrp0.Position.Y < 5 then
            hrp0.CFrame = CFrame.new(hrp0.Position.X, State.MinFlyHeight + 20, hrp0.Position.Z)
        end
    end

    local orbitAngle = 0
    local orbitActive = false
    local smoothedCenter = nil
    local lastSetPos = nil
    local rubberbandHits = 0
    local effectiveOrbitSpeed = State.OrbitSpeed
    local waitActive = false
    local waitUntil = 0

    while State.TPChase and State.Target == plr and State.Loaded do
        local hrp = getHRP()
        local tChar = plr.Character
        local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not (hrp and tHRP and tHum) or tHum.Health <= 0 then break end

        local tPos = tHRP.Position
        local myPos = hrp.Position
        local dist = (tPos - myPos).Magnitude

        if not waitActive and dist > State.MaxTargetDistance then
            local nearbyEnemy = false
            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= LP and other ~= plr then
                    local oHRP = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
                    local oHum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
                    if oHRP and oHum and oHum.Health > 0 and (oHRP.Position - myPos).Magnitude <= 1500 then
                        nearbyEnemy = true
                        break
                    end
                end
            end
            if not nearbyEnemy then
                waitActive = true
                waitUntil = tick() + 3
                hrp.Anchored = true
            else
                State.Target = nil
                break
            end
        end

        if waitActive then
            if dist <= State.MaxTargetDistance then
                waitActive = false
                hrp.Anchored = false
                -- Snap back to safe altitude on un-anchor
                hrp.CFrame = CFrame.new(hrp.Position.X, math.max(hrp.Position.Y, State.MinFlyHeight), hrp.Position.Z)
                orbitActive = false
                smoothedCenter = nil
            elseif tick() >= waitUntil then
                waitActive = false
                hrp.Anchored = false
                State.FarBlacklist[plr.UserId] = tick() + 10
                State.Target = nil
                break
            else
                task.wait(0.05)
            end
        end

        if not waitActive then
            -- Target center with MinFlyHeight floor
            local targetCenter = tPos + Vector3.new(0, State.OrbitHeight, 0)
            if targetCenter.Y < State.MinFlyHeight then
                targetCenter = Vector3.new(targetCenter.X, State.MinFlyHeight, targetCenter.Z)
            end
            local horizDist = (Vector3.new(tPos.X, myPos.Y, tPos.Z) - myPos).Magnitude

            if not orbitActive and horizDist < State.OrbitRadius + 10 then
                orbitActive = true
                local rel = myPos - targetCenter
                orbitAngle = math.atan2(rel.Z, rel.X)
                smoothedCenter = targetCenter
            end

            if orbitActive then
                local dt = math.min(task.wait(), 0.05)
                if smoothedCenter and (smoothedCenter - targetCenter).Magnitude > 60 then
                    smoothedCenter = targetCenter
                end
                if not smoothedCenter then smoothedCenter = targetCenter end
                smoothedCenter = smoothedCenter:Lerp(targetCenter, math.min(1, 15 * dt))
                -- Y floor on smoothed orbit center
                if smoothedCenter.Y < State.MinFlyHeight then
                    smoothedCenter = Vector3.new(smoothedCenter.X, State.MinFlyHeight, smoothedCenter.Z)
                end
                orbitAngle = orbitAngle + effectiveOrbitSpeed * dt

                local offset = Vector3.new(
                    math.cos(orbitAngle) * State.OrbitRadius,
                    0,
                    math.sin(orbitAngle) * State.OrbitRadius
                )
                local newPos = smoothedCenter + offset
                -- Y floor on final orbit position
                if newPos.Y < State.MinFlyHeight then
                    newPos = Vector3.new(newPos.X, State.MinFlyHeight, newPos.Z)
                end
                local moveDelta = (newPos - hrp.Position).Magnitude
                if moveDelta > 8 then
                    newPos = hrp.Position + (newPos - hrp.Position).Unit * 8
                end
                hrp.CFrame = CFrame.lookAt(newPos, Vector3.new(tPos.X, newPos.Y, tPos.Z))

                if lastSetPos then
                    local mismatch = (hrp.Position - lastSetPos).Magnitude
                    if mismatch > 8 then
                        rubberbandHits = rubberbandHits + 1
                        if rubberbandHits >= 3 then
                            effectiveOrbitSpeed = math.max(3, effectiveOrbitSpeed * 0.7)
                            rubberbandHits = 0
                        end
                    else
                        rubberbandHits = math.max(0, rubberbandHits - 1)
                        effectiveOrbitSpeed = math.min(State.OrbitSpeed, effectiveOrbitSpeed + 0.2)
                    end
                end
                lastSetPos = newPos
            else
                local distToCenter = (targetCenter - myPos).Magnitude
                if distToCenter < 5 then
                    orbitActive = true
                    smoothedCenter = targetCenter
                    local rel = myPos - targetCenter
                    orbitAngle = math.atan2(rel.Z, rel.X)
                else
                    -- Per-frame CFrame (replaces tween for physics stability)
                    local dt = math.min(task.wait(), 0.05)
                    local chunkMove = math.min(distToCenter, State.ChaseSpeed * dt)
                    local direction = (targetCenter - myPos).Unit
                    local newPos = myPos + direction * chunkMove
                    if newPos.Y < State.MinFlyHeight then
                        newPos = Vector3.new(newPos.X, State.MinFlyHeight, newPos.Z)
                    end
                    hrp.CFrame = CFrame.lookAt(newPos, Vector3.new(tPos.X, newPos.Y, tPos.Z))
                end
            end
        end
    end

    local hrp = getHRP()
    if hrp then hrp.Anchored = false end
    if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
end

-- ============================================
-- AUTO M1
-- ============================================
local function getEquippedTool()
    local char = getChar()
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then return child end
    end
    return nil
end

local function getRange()
    local hrp = getHRP()
    if hrp and hrp:FindFirstChild("Buddha") then return State.BuddhaRange end
    return State.AttackRange
end

local function autoM1()
    local char = getChar()
    local hrp = getHRP()
    if not (char and hrp) then return end
    local tool = getEquippedTool()
    if not tool then return end
    local range = getRange()

    local hitList = {}
    local firstHead = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and isAttackable(plr) then
            local tChar = plr.Character
            local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHead = tChar and tChar:FindFirstChild("Head")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if tChar and tHRP and tHead and tHum and tHum.Health > 0 then
                if (tHRP.Position - hrp.Position).Magnitude <= range then
                    table.insert(hitList, {tChar, tHead})
                    if not firstHead then firstHead = tHead end
                end
            end
        end
    end
    if not firstHead then return end

    if tool:FindFirstChild("LeftClickRemote") then
        local idx = 1
        for _, entry in ipairs(hitList) do
            local tHRP = entry[1]:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local dir = (tHRP.Position - hrp.Position).Unit
                pcall(function() tool.LeftClickRemote:FireServer(dir, idx) end)
                idx = idx + 1
            end
        end
        return
    end

    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if not net then return end
    local regAttack = net:FindFirstChild("RE/RegisterAttack")
    local regHit = net:FindFirstChild("RE/RegisterHit")
    if not (regAttack and regHit) then return end
    pcall(function()
        regAttack:FireServer(0.1)
        regHit:FireServer(firstHead, hitList)
    end)
end

-- ============================================
-- TARGET LIST
-- ============================================
local function rebuildTargetList()
    local hrp = getHRP()
    local list = {}
    if hrp then
        for uid, expiry in pairs(State.FarBlacklist) do
            if tick() >= expiry then State.FarBlacklist[uid] = nil end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and not State.FarBlacklist[plr.UserId] and isAttackable(plr) then
                local tChar = plr.Character
                local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                if tHRP and tHum and tHum.Health > 0 then
                    local d = (tHRP.Position - hrp.Position).Magnitude
                    if d <= State.MaxTargetDistance then
                        table.insert(list, {Player = plr, Distance = d})
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.Distance < b.Distance end)
    end
    State.TargetList = list
    if #list == 0 then
        State.TargetIndex = 1
        State.Target = nil
    else
        if State.TargetIndex > #list then State.TargetIndex = 1 end
        State.Target = list[State.TargetIndex].Player
    end
end

local function cycleTarget()
    rebuildTargetList()
    if #State.TargetList == 0 then return end
    State.TargetIndex = (State.TargetIndex % #State.TargetList) + 1
    State.Target = State.TargetList[State.TargetIndex].Player
end

-- ============================================
-- MAIN LOOP
-- ============================================
local lastAttack = 0
local lastListRebuild = 0

local heartbeatConn = RunService.Heartbeat:Connect(function()
    if tick() - lastListRebuild > 1 then
        lastListRebuild = tick()
        local prevTarget = State.Target
        rebuildTargetList()
        if prevTarget then
            for i, entry in ipairs(State.TargetList) do
                if entry.Player == prevTarget then
                    State.TargetIndex = i
                    State.Target = prevTarget
                    break
                end
            end
        end
    end

    if State.TPChase and not tpRunning then
        local t = State.Target
        local tHum = t and t.Character and t.Character:FindFirstChildOfClass("Humanoid")
        if t and tHum and tHum.Health > 0 then
            tpRunning = true
            task.spawn(function()
                chaseLoop(t)
                tpRunning = false
            end)
        end
    end

    if State.AutoM1 then
        local now = tick()
        if now - lastAttack >= 0.1 then
            pcall(autoM1)
            lastAttack = now
        end
    end
end)

