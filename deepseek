-- Status updater
task.spawn(function()
    while State.Loaded do
        task.wait(1)
        if not statusFrame.Parent then break end

        if Runtime.NoFogApplied then
            nofogLine.Text = "✓ NoFog working"
            nofogLine.TextColor3 = Color3.fromRGB(100, 220, 140)
        else
            nofogLine.Text = "… NoFog pending"
            nofogLine.TextColor3 = Color3.fromRGB(220, 180, 80)
        end

        if Runtime.FPSApplied then
            fpsLine.Text = "✓ FPS Boost working"
            fpsLine.TextColor3 = Color3.fromRGB(100, 220, 140)
        else
            fpsLine.Text = "… FPS Boost pending"
            fpsLine.TextColor3 = Color3.fromRGB(220, 180, 80)
        end

        if Runtime.LavaRemoved then
            lavaLine.Text = "✓ Lava removed"
            lavaLine.TextColor3 = Color3.fromRGB(100, 220, 140)
        else
            lavaLine.Text = "… Lava pending"
            lavaLine.TextColor3 = Color3.fromRGB(220, 180, 80)
        end

        local ping = Runtime.Ping
        local fps = math.floor(Runtime.FPS + 0.5)
        perfLine.Text = string.format("FPS: %d   Ping: %dms", fps, ping)
        if fps >= 40 and ping < 150 then
            perfLine.TextColor3 = Color3.fromRGB(100, 220, 140)
        elseif fps >= 20 and ping < 300 then
            perfLine.TextColor3 = Color3.fromRGB(220, 200, 100)
        else
            perfLine.TextColor3 = Color3.fromRGB(220, 100, 100)
        end
    end
end)

-- Target info updater
task.spawn(function()
    while State.Loaded do
        task.wait(0.2)
        if not frame.Parent then break end
        local t = State.Target
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = getHRP()
            local tHRP = t.Character:FindFirstChild("HumanoidRootPart")
            local d = (hrp and tHRP) and math.floor((tHRP.Position - hrp.Position).Magnitude) or 0
            targetName.Text = "Target: " .. t.Name
            targetId.Text = string.format("ID: %d   Dist: %dm", t.UserId, d)
        else
            targetName.Text = "Target: none"
            targetId.Text = "ID: -   Dist: -"
        end
    end
end)

