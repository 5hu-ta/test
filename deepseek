-- ============================================
-- STATE
-- ============================================
local State = {
    TPChase = false,
    AutoM1 = false,
    Target = nil,
    GhostPart = nil,
    Tween = nil,
    ChaseSpeed = 180,        -- 下げた: アンチチート検知を避ける
    ChunkSize = 350,         -- studs per chunk
    ChunkWait = 0.05,        -- seconds between chunks
    AttackRange = 60,
    BuddhaRange = 1000,
}

-- ============================================
-- HELPERS
-- ============================================
local function getChar() return LP.Character end
local function getHRP() return getChar() and getChar():FindFirstChild("HumanoidRootPart") end
local function getHum() return getChar() and getChar():FindFirstChildOfClass("Humanoid") end

-- ============================================
-- REMOVE LAVA (unchanged)
-- ============================================
local function removeLava()
    local removed = false
    local mapPart = workspace:FindFirstChild("Map")
    if mapPart then
        for _, mapName in ipairs({"CircleIsland", "GhostShipInterior"}) do
            local v2 = mapPart:FindFirstChild(mapName)
            if v2 then
                for _, desc in ipairs(v2:GetDescendants()) do
                    if desc.Name == "LavaParts" then
                        desc:Destroy()
                        removed = true
                    end
                end
            end
        end
    end
    return removed
end

-- ============================================
-- TP CHASE — chunked + speed-capped
-- ============================================
local function tweenHRPTo(targetPos, speed)
    local hrp = getHRP()
    if not hrp then return end

    local startPos = hrp.Position
    local totalDist = (targetPos - startPos).Magnitude
    if totalDist < 1 then return end

    -- HumanoidをPhysics状態にしてTween競合を防ぐ
    local hum = getHum()
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end

    local chunks = math.ceil(totalDist / State.ChunkSize)
    local chunkDist = totalDist / chunks

    for i = 1, chunks do
        if not State.TPChase then break end -- abort if toggled off

        hrp = getHRP()
        if not hrp then break end

        local currentPos = hrp.Position
        local direction = (targetPos - currentPos).Unit
        local chunkTarget = currentPos + direction * chunkDist

        -- last chunk: snap to exact target
        if i == chunks then
            chunkTarget = targetPos
        end

        local dist = (chunkTarget - currentPos).Magnitude
        if dist < 0.5 then break end

        local duration = dist / speed
        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            {CFrame = CFrame.new(chunkTarget, chunkTarget + hrp.CFrame.LookVector * 5)}
        )
        tween:Play()

        -- wait for completion with timeout (avoid stuck)
        local done = false
        local conn
        conn = tween.Completed:Connect(function()
            done = true
            conn:Disconnect()
        end)
        local timeout = tick() + duration + 1
        while not done and tick() < timeout do
            task.wait(0.01)
            if not State.TPChase then
                tween:Cancel()
                conn:Disconnect()
                break
            end
        end

        if State.TPChase then
            task.wait(State.ChunkWait) -- let server process position
        end
    end
end

-- ============================================
-- AUTO M1 (unchanged)
-- ============================================
local function getEquippedTool()
    local char = getChar()
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then return child end
    end
    return nil
end

local function getRange()
    local hrp = getHRP()
    if hrp and hrp:FindFirstChild("Buddha") then
        return State.BuddhaRange
    end
    return State.AttackRange
end

local function autoM1()
    local char = getChar()
    local hrp = getHRP()
    if not (char and hrp) then return end
    local tool = getEquippedTool()
    if not tool then return end
    local range = getRange()

    local hitList = {}
    local firstHead = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local tChar = plr.Character
            local tHRP = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHead = tChar and tChar:FindFirstChild("Head")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            if tChar and tHRP and tHead and tHum and tHum.Health > 0 then
                if (tHRP.Position - hrp.Position).Magnitude <= range then
                    table.insert(hitList, {tChar, tHead})
                    if not firstHead then firstHead = tHead end
                end
            end
        end
    end
    if not firstHead then return end

    if tool:FindFirstChild("LeftClickRemote") then
        local idx = 1
        for _, entry in ipairs(hitList) do
            local tHRP = entry[1]:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local dir = (tHRP.Position - hrp.Position).Unit
                pcall(function() tool.LeftClickRemote:FireServer(dir, idx) end)
                idx = idx + 1
            end
        end
        return
    end

    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local net = modules and modules:FindFirstChild("Net")
    if not net then return end
    local regAttack = net:FindFirstChild("RE/RegisterAttack")
    local regHit = net:FindFirstChild("RE/RegisterHit")
    if not (regAttack and regHit) then return end

    pcall(function()
        regAttack:FireServer(0.1)
        regHit:FireServer(firstHead, hitList)
    end)
end

-- ============================================
-- TARGET SCANNER (nearest)
-- ============================================
local function scanTarget()
    local hrp = getHRP()
    if not hrp then State.Target = nil; return end
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local tHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local tHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if tHRP and tHum and tHum.Health > 0 then
                local d = (tHRP.Position - hrp.Position).Magnitude
                if d < bestDist then best, bestDist = plr, d end
            end
        end
    end
    State.Target = best
end

-- ============================================
-- MAIN LOOP
-- ============================================
local lastAttack = 0
local tpRunning = false

RunService.Heartbeat:Connect(function()
    -- TP Chase
    if State.TPChase and not tpRunning then
        scanTarget()
        if State.Target then
            local tHRP = State.Target.Character and State.Target.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                tpRunning = true
                task.spawn(function()
                    tweenHRPTo(tHRP.Position - Vector3.new(0, 3, 0), State.ChaseSpeed)
                    tpRunning = false
                end)
            end
        end
    end

    -- Auto M1
    if State.AutoM1 then
        local now = tick()
        if now - lastAttack >= 0.1 then
            pcall(autoM1)
            lastAttack = now
        end
    end
end)

