-- ============================================================
-- 0. EXECUTOR COMPATIBILITY LAYER
-- ============================================================
-- Xeno: getconnections often fails, hookfunction unreliable.
-- Delta/Real: mostly full UNC. We feature-detect and degrade.
-- ============================================================

local ENV = getgenv()

local function has(fn)
    return type(rawget(ENV, fn)) == "function" or type(rawget(_G, fn)) == "function"
end

local COMPAT = {
    hookmetamethod  = has("hookmetamethod") or has("hookfunction"),
    getrawmetatable = has("getrawmetatable"),
    setreadonly     = has("setreadonly"),
    checkcaller     = has("checkcaller") or function() return false end,
    getnamecallmethod = has("getnamecallmethod"),
    Drawing         = has("Drawing") or (typeof(Drawing) == "table" and Drawing.new ~= nil),
    is_synapse       = has("syn") or has("is_sirhurt_closure"),
}

local function compat_warn(msg)
    warn("[AutoBounty][COMPAT] " .. msg)
end

if not COMPAT.Drawing then
    compat_warn("Drawing library not found. ESP disabled.")
end

