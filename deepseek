-- ============================================
-- TOOL CLASSIFICATION
-- ============================================
local FightingStyleNames = {
    ["Combat"] = true, ["Dark Step"] = true, ["Electric Claw"] = true,
    ["Dragon Talon"] = true, ["Superhuman"] = true, ["Death Step"] = true,
    ["Sharkman Karate"] = true, ["Godhuman"] = true, ["Sanguine Art"] = true,
}

local function getToolType(tool)
    local wt = tool:GetAttribute("WeaponType") or tool:GetAttribute("ItemType")
    if type(wt) == "string" then
        local lw = wt:lower()
        if lw:find("sword") then return "Sword" end
        if lw:find("gun") then return "Gun" end
        if lw:find("melee") or lw:find("fighting") then return "Fighting" end
        if lw:find("fruit") then return "Fruit" end
    end
    if tool:GetAttribute("SwordType") then return "Sword" end
    if tool:GetAttribute("GunType") then return "Gun" end
    if tool:GetAttribute("FruitType") then return "Fruit" end
    if FightingStyleNames[tool.Name] then return "Fighting" end
    if tool:FindFirstChild("SwordRemote") then return "Sword" end
    if tool:FindFirstChild("GunRemote") then return "Gun" end
    if tool:FindFirstChild("FruitRemote") then return "Fruit" end
    return nil
end

local function findToolByType(wantedType)
    local bp = LP:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and getToolType(t) == wantedType then
            return t
        end
    end
    return nil
end

local function equipTool(tool)
    local char = getChar()
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return pcall(function() hum:EquipTool(tool) end)
end

local function fireKey(keyName)
    local keyCode = Enum.KeyCode[keyName]
    if not keyCode then return end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- ============================================
-- AIM HELPERS (skill aim correction)
