task.spawn(function()
    while State.Loaded do
        task.wait(0.2)
        if not main.Parent then break end

        -- Player
        local bounty = getBounty(LP) or 0
        lblBounty.Text = commaFormat(bounty)
        lblBeli.Text = commaFormat(getBeli(LP))
        lblLevel.Text = tostring(getLevel(LP) or "?")
        local hum = getHum()
        if hum then
            lblHealth.Text = string.format("%s/%s", commaFormat(hum.Health), commaFormat(hum.MaxHealth))
        else
            lblHealth.Text = "Dead"
        end

        -- Stats
        if Stats.LastBounty == 0 then Stats.LastBounty = bounty end
        if bounty > Stats.LastBounty then
            Stats.BountyEarned = Stats.BountyEarned + (bounty - Stats.LastBounty)
        end
        Stats.LastBounty = bounty
        lblEarned.Text = commaFormat(Stats.BountyEarned)
        lblKills.Text = tostring(Stats.TotalKills)

        local elapsed = os.time() - Stats.StartTime
        lblTime.Text = string.format("%02d:%02d:%02d",
            math.floor(elapsed / 3600),
            math.floor((elapsed % 3600) / 60),
            elapsed % 60)

        local ping = math.floor((LP:GetNetworkPing() or 0) * 1000 + 0.5)
        lblPing.Text = string.format("%dms / %d", ping, fpsValue)

        -- Target
        local t = State.Target
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = getHRP()
            local tHRP = t.Character:FindFirstChild("HumanoidRootPart")
            local d = (hrp and tHRP) and math.floor((tHRP.Position - hrp.Position).Magnitude) or 0
            local tHum = t.Character:FindFirstChildOfClass("Humanoid")
            lblTName.Text = t.Name
            lblTDist.Text = d .. "m"
            if tHum then
                lblTHP.Text = string.format("%s/%s", commaFormat(tHum.Health), commaFormat(tHum.MaxHealth))
            else
                lblTHP.Text = "-"
            end

            local tags = {}
            if isInSafeZone(t) then table.insert(tags, "SAFE") end
            if isPvpOff(t) then table.insert(tags, "PVP OFF") end
            if #tags > 0 then
                lblTState.Text = table.concat(tags, " / ")
                lblTState.TextColor3 = Color3.fromRGB(255, 120, 120)
            else
                lblTState.Text = "OK"
                lblTState.TextColor3 = Color3.fromRGB(120, 220, 120)
            end
        else
            lblTName.Text = "-"
            lblTDist.Text = "-"
            lblTHP.Text = "-"
            lblTState.Text = "-"
            lblTState.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end
end)

